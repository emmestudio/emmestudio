{
  "name": "emme-studio-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-consolidation.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:integration": "node test/management.integration.mjs",
    "test:visual": "node test/management.integration.mjs --visual",
    "test:consolidation": "node test/consolidation.integration.mjs && node test/message-attachment-upload.integration.mjs",
    "test:all": "npm test && npm run test:integration && npm run test:consolidation && node test/production-finance.integration.mjs && node test/drive-archive.integration.mjs && node test/artist-area-db.integration.mjs && node --test test/artist-access-policy.test.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "better-auth": "1.7.7",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  }
}
